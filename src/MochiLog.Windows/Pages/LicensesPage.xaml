<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="MochiLog_Windows.Pages.LicensesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="PageViewport">
    <Grid Style="{StaticResource CompanionPageGridStyle}" RowSpacing="16"
          Width="{Binding ActualWidth, ElementName=PageViewport}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}"
                   AutomationProperties.AutomationId="PageHeading" />
        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListView x:Name="DocumentList" SelectionChanged="DocumentChanged" />
            <TextBox x:Name="DocumentText" Grid.Column="1" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" />
        </Grid>
    </Grid>
    </Grid>
</Page>
