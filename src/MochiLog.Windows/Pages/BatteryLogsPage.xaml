<Page x:Class="MochiLog_Windows.Pages.BatteryLogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="1200" Padding="28" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="PageIntro" TextWrapping="Wrap" Opacity="0.7" />
            </StackPanel>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="18" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="StorageTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch x:Name="KeepToggle" Toggled="SettingsChanged" />
                    <TextBlock x:Name="KeepHint" TextWrapping="Wrap" Opacity="0.72" />
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <NumberBox x:Name="LimitBox" Width="220" Minimum="100" Maximum="100000"
                                   SmallChange="100" SpinButtonPlacementMode="Inline"
                                   ValueChanged="NumberSettingsChanged" />
                        <NumberBox x:Name="MonthsBox" Width="210" Minimum="1" Maximum="60"
                                   SmallChange="1" SpinButtonPlacementMode="Inline"
                                   ValueChanged="NumberSettingsChanged" />
                    </StackPanel>
                    <TextBlock x:Name="UsageText" Opacity="0.72" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="18" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" TextChanged="SearchChanged" />
                        <Button x:Name="RefreshButton" Grid.Column="1" Click="RefreshClicked" />
                    </Grid>
                    <ListView x:Name="LogsList" Height="400" SelectionMode="Multiple"
                              SelectionChanged="SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Name}" Opacity="0.65"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding KindAndDay}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Status}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ExportButton" Click="ExportClicked" />
                        <Button x:Name="ResendButton" Click="ResendClicked" />
                        <Button x:Name="DeleteButton" Click="DeleteClicked" />
                    </StackPanel>
                    <TextBlock x:Name="PendingHint" TextWrapping="Wrap" Opacity="0.7" />
                    <TextBlock x:Name="NoticeText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
