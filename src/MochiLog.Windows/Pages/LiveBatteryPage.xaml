<Page x:Class="MochiLog_Windows.Pages.LiveBatteryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="ContentScroll" Style="{StaticResource CompanionPageScrollStyle}">
        <StackPanel x:Name="ContentColumn" Style="{StaticResource CompanionPageColumnStyle}"
                    Width="{Binding ActualWidth, ElementName=ContentScroll}"
                    AutomationProperties.AutomationId="PageColumn">
            <TextBlock x:Name="LiveBatteryTitle" Style="{StaticResource TitleTextBlockStyle}"
                       AutomationProperties.AutomationId="PageHeading" />
            <TextBlock x:Name="LiveBatteryNote" TextWrapping="Wrap" Opacity="0.68" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="LiveBatteryReceive" Click="LiveBatteryReceiveClicked" />
                <Button x:Name="LiveBatterySend" Click="LiveBatterySendClicked" />
            </StackPanel>
            <StackPanel x:Name="LiveBatteryCards" Spacing="20" />
        </StackPanel>
    </ScrollViewer>
</Page>
