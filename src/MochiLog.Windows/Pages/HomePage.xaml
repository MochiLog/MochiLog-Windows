<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MochiLog_Windows.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel MaxWidth="920" Padding="28" Spacing="22">
            <StackPanel Spacing="5">
                <TextBlock Text="MochiLog Windows" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="SubtitleText" TextWrapping="Wrap" Opacity="0.72" />
            </StackPanel>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="18" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="StatusTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                    <TextBlock x:Name="CollectionText" TextWrapping="Wrap" Opacity="0.72" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="RefreshButton" Click="RefreshClicked" />
                        <Button x:Name="CollectButton" Click="CollectClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="18" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="SetupTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="SetupRequirement" TextWrapping="Wrap" />
                    <TextBlock x:Name="SoftwareStatus" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <HyperlinkButton x:Name="AppleDevicesLink" NavigateUri="https://support.apple.com/guide/devices-windows/mchl5ded2763/windows" />
                        <HyperlinkButton x:Name="ITunesLink" NavigateUri="https://www.apple.com/itunes/download/win64" />
                        <Button x:Name="SoftwareRefreshButton" Click="SoftwareRefreshClicked" />
                    </StackPanel>
                    <TextBlock x:Name="ICloudNote" TextWrapping="Wrap" Opacity="0.72" />
                    <TextBlock x:Name="SetupStep1" TextWrapping="Wrap" />
                    <TextBlock x:Name="SetupStep2" TextWrapping="Wrap" />
                    <TextBlock x:Name="SetupStep3" TextWrapping="Wrap" />
                    <TextBlock x:Name="DeviceSelectionHint" TextWrapping="Wrap" Opacity="0.72" />
                    <RadioButtons x:Name="DeviceList" MaxColumns="1">
                        <RadioButtons.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="4,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36"
                                            CornerRadius="10" Background="{Binding BadgeBackground}">
                                        <FontIcon Glyph="&#xE8EA;" FontSize="19"
                                                  Foreground="{Binding AccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Model}" Opacity="0.68"
                                                   FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{Binding BadgeBackground}"
                                            CornerRadius="9" Padding="8,5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="{Binding BadgeGlyph}" FontSize="13"
                                                      Foreground="{Binding AccentBrush}" />
                                            <TextBlock Text="{Binding BadgeText}" FontSize="12"
                                                       Foreground="{Binding AccentBrush}"
                                                       TextWrapping="Wrap" MaxWidth="150" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </RadioButtons.ItemTemplate>
                    </RadioButtons>
                    <Button x:Name="UsbButton" Click="UsbClicked" HorizontalAlignment="Left" />
                    <Button x:Name="PairButton" Click="PairClicked" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="18" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="PairedTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ListView x:Name="PairedList" Height="130" SelectionMode="Single" />
                    <Button x:Name="UnpairButton" Click="UnpairClicked" />
                    <TextBlock x:Name="ManualAddressHint" TextWrapping="Wrap" Opacity="0.72" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="ManualAddressBox" Width="220" PlaceholderText="192.168.1.20" />
                        <Button x:Name="SaveManualAddressButton" Click="SaveManualAddressClicked" />
                        <Button x:Name="ClearManualAddressButton" Click="ClearManualAddressClicked" />
                    </StackPanel>
                    <TextBlock x:Name="ProcessingNote" TextWrapping="Wrap" Opacity="0.72" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
